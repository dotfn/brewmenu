---
import { Star } from "@lucide/astro";

const githubUrl = "https://github.com/dotfn/brewmenu";

let stars: string | null = null;
try {
  const res = await fetch("https://api.github.com/repos/dotfn/brewmenu");
  if (res.ok) {
    const { stargazers_count } = await res.json();
    stars = new Intl.NumberFormat("en", { notation: "compact" }).format(stargazers_count);
  }
} catch {
  // Offline build or rate-limited: badge just drops the count below.
}
---

<header class="fixed inset-x-0 top-0 z-50 h-14 bg-black">
  <div class="mx-auto flex h-full max-w-6xl items-center justify-between px-6">
    <a href="#top" class="flex items-center gap-2 font-text text-nav-link font-semibold text-white">
      <img src="/favicon.png" alt="" class="h-5 w-5 rounded-sm" width="20" height="20" />
      BrewMenu
    </a>
    <nav class="hidden items-center gap-6 font-text text-nav-link text-white/70 sm:flex">
      <a href="#features" class="transition hover:text-white">Features</a>
      <a href="#install" class="transition hover:text-white">Install</a>
      <div class="flex items-center overflow-hidden rounded-sm bg-ink">
        <a
          href={githubUrl}
          class="flex items-center gap-1.5 py-[8px] pr-3.5 pl-[15px] text-white transition hover:bg-white/10 active:scale-95"
        >
          <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          GitHub
        </a>
        <a
          href={`${githubUrl}/stargazers`}
          aria-label="Star BrewMenu on GitHub"
          class="group flex items-center gap-1.5 border-l border-white/15 py-[8px] pr-[15px] pl-3 font-text text-button-utility text-white/70 transition hover:bg-white/10 hover:text-yellow-400 active:scale-95"
        >
          <Star class="h-3.5 w-3.5 transition group-hover:fill-yellow-400" />
          {stars ?? "Star"}
        </a>
      </div>
    </nav>
    <div class="flex items-center overflow-hidden rounded-sm bg-ink sm:hidden">
      <a
        href={githubUrl}
        class="flex items-center gap-1.5 py-[8px] pr-3.5 pl-[15px] text-white transition hover:bg-white/10 active:scale-95"
      >
        <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        GitHub
      </a>
      <a
        href={`${githubUrl}/stargazers`}
        aria-label="Star BrewMenu on GitHub"
        class="group flex items-center gap-1.5 border-l border-white/15 py-[8px] pr-[15px] pl-3 font-text text-button-utility text-white/70 transition hover:bg-white/10 hover:text-yellow-400 active:scale-95"
      >
        <Star class="h-3.5 w-3.5 transition group-hover:fill-yellow-400" />
        {stars ?? "Star"}
      </a>
    </div>
  </div>
</header>
