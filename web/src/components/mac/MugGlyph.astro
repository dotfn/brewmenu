---
// The filled mug BrewMenu shows in the menu bar, drawn for the web after the app's own icon
// (SF Symbol `mug.fill`): straight sides, a well-rounded base, the opening cut as a slot at the
// top, a thin loop handle. Our own path — SF Symbols can't ship on the web. Uses currentColor.
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg viewBox="0 0 24 24" class={className} fill="currentColor" aria-hidden="true">
  <path
    fill-rule="evenodd"
    d="M5.5 3h9A1.5 1.5 0 0 1 16 4.5V16a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V4.5A1.5 1.5 0 0 1 5.5 3Zm1.1 1.2a.8.8 0 0 0 0 1.6h6.8a.8.8 0 0 0 0-1.6H6.6Z"
  ></path>
  <path
    d="M16 7.4h1.6A2.4 2.4 0 0 1 20 9.8v3a2.4 2.4 0 0 1-2.4 2.4H16v-1.3h1.6c.6 0 1.1-.5 1.1-1.1v-3c0-.6-.5-1.1-1.1-1.1H16V7.4Z"
  ></path>
</svg>
