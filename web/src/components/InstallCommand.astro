---
interface Props {
  command: string;
  copyLabel?: string;
  copiedLabel?: string;
  class?: string;
}

const { command, copyLabel = "Copy", copiedLabel = "Copied!", class: className = "" } = Astro.props;
---

<button
  type="button"
  data-copy={command}
  data-copied-label={copiedLabel}
  class:list={[
    "group flex w-full items-center justify-between gap-3 rounded-pill border border-hairline px-5 py-2.5 text-left transition active:scale-95 dark:border-white/15",
    className,
  ]}
>
  <span class="truncate font-mono text-fine-print text-ink-muted-80 dark:text-white/70">
    $ {command}
  </span>
  <span class="shrink-0 font-text text-fine-print font-medium text-primary dark:text-primary-on-dark" data-copy-label>
    {copyLabel}
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.dataset.copy;
      if (!value) return;
      await navigator.clipboard.writeText(value);
      const label = button.querySelector("[data-copy-label]");
      if (!label) return;
      const original = label.textContent;
      label.textContent = button.dataset.copiedLabel ?? "Copied!";
      setTimeout(() => {
        label.textContent = original;
      }, 1500);
    });
  });
</script>
