---
import { Home, LayoutGrid, Images, Download, CircleHelp, Search, ChevronDown, ArrowUpRight, Menu, X as CloseIcon } from "@lucide/astro";

interface Props {
  stars?: string | null;
}

const { stars = null } = Astro.props;

const githubUrl = "https://github.com/dotfn/brewmenu";
const dotfnUrl = "https://dotfn.dev";
const xUrl = "https://x.com/dotfn_";

const nav = [
  { href: "#top", label: "Overview", icon: Home, active: true },
  { href: "#screenshots", label: "Screenshots", icon: Images },
  { href: "#features", label: "Features", icon: LayoutGrid },
  { href: "#install", label: "Install", icon: Download },
  { href: "#faq", label: "FAQ", icon: CircleHelp },
];

const elsewhere = [
  { href: dotfnUrl, label: "dotfn.dev", iconDot: true },
  { href: githubUrl, label: `GitHub${stars ? ` · ${stars}★` : ""}`, iconSvg: true },
  { href: xUrl, label: "X / Twitter", iconX: true },
];
---

<!-- Desktop sidebar -->
<aside class="hidden bg-sidebar lg:fixed lg:inset-y-0 lg:left-0 lg:z-40 lg:flex lg:w-[240px] lg:flex-col lg:border-r lg:border-white/[0.06] lg:px-3 lg:py-4">
  <a href={dotfnUrl} class="flex items-center gap-2 rounded-lg px-2 py-1.5 transition hover:bg-white/5">
    <span class="h-5 w-5 shrink-0 rounded-full bg-white" aria-hidden="true"></span>
    <span class="font-text text-tagline font-semibold text-white">dotfn</span>
    <ChevronDown class="h-3.5 w-3.5 text-white/40" />
  </a>

  <a
    href="https://formulae.brew.sh/"
    target="_blank"
    rel="noreferrer"
    class="mt-4 flex items-center gap-2 rounded-pill bg-black/40 px-3 py-2 text-white/40 transition hover:text-white/70"
  >
    <Search class="h-3.5 w-3.5 shrink-0" />
    <span class="truncate font-text text-caption">Search formulae &amp; casks</span>
  </a>

  <nav class="mt-5 flex flex-col gap-0.5">
    {
      nav.map(({ href, label, icon: Icon, active }) => (
        <a
          href={href}
          class:list={[
            "flex items-center gap-2.5 rounded-lg px-2.5 py-[7px] font-text text-caption transition",
            active ? "bg-white/10 text-white" : "text-white/70 hover:bg-white/5 hover:text-white",
          ]}
        >
          <Icon class="h-4 w-4 shrink-0" />
          {label}
        </a>
      ))
    }
  </nav>

  <p class="mt-7 px-2.5 font-text text-nav-link font-semibold tracking-wide text-white/35 uppercase">Elsewhere</p>
  <nav class="mt-1.5 flex flex-col gap-0.5">
    {
      elsewhere.map(({ href, label, iconDot, iconSvg, iconX }) => (
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          class="group flex items-center gap-2.5 rounded-lg px-2.5 py-[7px] font-text text-caption text-white/70 transition hover:bg-white/5 hover:text-white"
        >
          {iconDot && <span class="h-4 w-4 shrink-0 rounded-full bg-current" aria-hidden="true" />}
          {iconSvg && (
            <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
            </svg>
          )}
          {iconX && (
            <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0" fill="currentColor" aria-hidden="true">
              <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.6.75Zm-.86 13.028h1.36L4.323 2.145H2.865z" />
            </svg>
          )}
          <span class="truncate">{label}</span>
          <ArrowUpRight class="ml-auto h-4 w-4 shrink-0 text-white/0 transition group-hover:text-white/40" />
        </a>
      ))
    }
  </nav>
</aside>

<!-- Mobile top bar + drawer -->
<div class="sticky top-0 z-40 flex h-14 items-center justify-between border-b border-white/[0.06] bg-sidebar px-4 lg:hidden">
  <a href={dotfnUrl} class="flex items-center gap-2">
    <span class="h-5 w-5 shrink-0 rounded-full bg-white" aria-hidden="true"></span>
    <span class="font-text text-tagline font-semibold text-white">dotfn</span>
  </a>
  <button
    type="button"
    id="sidebar-open"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="sidebar-drawer"
    class="flex h-8 w-8 items-center justify-center rounded-full text-white/70 transition active:scale-95"
  >
    <Menu class="h-5 w-5" />
  </button>
</div>

<div id="sidebar-drawer" class="pointer-events-none fixed inset-0 z-50 lg:hidden" hidden>
  <button
    type="button"
    id="sidebar-backdrop"
    aria-label="Close menu"
    class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-200"
  ></button>
  <div
    id="sidebar-panel"
    class="absolute inset-y-0 left-0 flex w-[260px] -translate-x-full flex-col bg-sidebar px-3 py-4 transition-transform duration-200"
  >
    <div class="flex items-center justify-between px-2 py-1.5">
      <a href={dotfnUrl} class="flex items-center gap-2">
        <span class="h-5 w-5 shrink-0 rounded-full bg-white" aria-hidden="true"></span>
        <span class="font-text text-tagline font-semibold text-white">dotfn</span>
      </a>
      <button type="button" id="sidebar-close" aria-label="Close menu" class="flex h-8 w-8 items-center justify-center rounded-full text-white/60 active:scale-95">
        <CloseIcon class="h-5 w-5" />
      </button>
    </div>

    <nav class="mt-4 flex flex-col gap-0.5" data-drawer-nav>
      {
        nav.map(({ href, label, icon: Icon, active }) => (
          <a
            href={href}
            class:list={[
              "flex items-center gap-2.5 rounded-lg px-2.5 py-2 font-text text-caption transition",
              active ? "bg-white/10 text-white" : "text-white/70 hover:bg-white/5 hover:text-white",
            ]}
          >
            <Icon class="h-4 w-4 shrink-0" />
            {label}
          </a>
        ))
      }
    </nav>

    <p class="mt-6 px-2.5 font-text text-nav-link font-semibold tracking-wide text-white/35 uppercase">Elsewhere</p>
    <nav class="mt-1.5 flex flex-col gap-0.5">
      {
        elsewhere.map(({ href, label, iconDot, iconSvg, iconX }) => (
          <a href={href} target="_blank" rel="noreferrer" class="flex items-center gap-2.5 rounded-lg px-2.5 py-2 font-text text-caption text-white/70 transition hover:bg-white/5 hover:text-white">
            {iconDot && <span class="h-4 w-4 shrink-0 rounded-full bg-current" aria-hidden="true" />}
            {iconSvg && (
              <svg viewBox="0 0 16 16" class="h-4 w-4 shrink-0" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            )}
            {iconX && (
              <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 shrink-0" fill="currentColor" aria-hidden="true">
                <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.6.75Zm-.86 13.028h1.36L4.323 2.145H2.865z" />
              </svg>
            )}
            <span class="truncate">{label}</span>
          </a>
        ))
      }
    </nav>
  </div>
</div>

<script>
  const drawer = document.getElementById("sidebar-drawer");
  const panel = document.getElementById("sidebar-panel");
  const backdrop = document.getElementById("sidebar-backdrop");
  const openBtn = document.getElementById("sidebar-open");
  const closeBtn = document.getElementById("sidebar-close");

  function openDrawer() {
    if (!drawer || !panel || !backdrop) return;
    drawer.hidden = false;
    drawer.classList.remove("pointer-events-none");
    openBtn?.setAttribute("aria-expanded", "true");
    requestAnimationFrame(() => {
      panel.classList.remove("-translate-x-full");
      backdrop.classList.remove("opacity-0");
    });
  }

  function closeDrawer() {
    if (!drawer || !panel || !backdrop) return;
    panel.classList.add("-translate-x-full");
    backdrop.classList.add("opacity-0");
    openBtn?.setAttribute("aria-expanded", "false");
    setTimeout(() => {
      drawer.hidden = true;
      drawer.classList.add("pointer-events-none");
    }, 200);
  }

  openBtn?.addEventListener("click", openDrawer);
  closeBtn?.addEventListener("click", closeDrawer);
  backdrop?.addEventListener("click", closeDrawer);
  document.querySelectorAll("[data-drawer-nav] a").forEach((a) => a.addEventListener("click", closeDrawer));
</script>
