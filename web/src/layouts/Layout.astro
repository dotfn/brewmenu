---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BrewMenu: Homebrew, actually visible",
  description = "A native macOS menu bar app for Homebrew: see updates, doctor warnings, cleanups, and services at a glance, without touching the terminal.",
} = Astro.props;

const ogImage = new URL("/og-image.png", Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "BrewMenu",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15+",
  description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://opensource.org/licenses/MIT",
  author: {
    "@type": "Organization",
    name: "dotfn",
    url: "https://dotfn.dev",
  },
  codeRepository: "https://github.com/dotfn/brewmenu",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={pageUrl} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="BrewMenu" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="es_ES" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The BrewMenu Dashboard showing outdated Homebrew packages with Update buttons" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dotfn_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="The BrewMenu Dashboard showing outdated Homebrew packages with Update buttons" />

    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js");
      }
    </script>
  </head>
  <body class="bg-void font-text text-white antialiased selection:bg-primary/30">
    <slot />
  </body>
</html>
