---
import { Font } from "astro:assets";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import type { Lang } from "../i18n/utils";

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  ogImageAlt?: string;
}

const {
  lang = "en",
  title = "BrewMenu: Homebrew, actually visible",
  description = "A native macOS menu bar app for Homebrew: see updates, doctor warnings, cleanups, and services at a glance, without touching the terminal.",
  ogImageAlt = "BrewMenu: a native macOS menu bar app for Homebrew",
} = Astro.props;

const ogImage = new URL("/og-image.png", Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogLocale = lang === "es" ? "es_ES" : "en_US";
const ogLocaleAlternate = lang === "es" ? "en_US" : "es_ES";

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "BrewMenu",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS 15+",
  description,
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  license: "https://opensource.org/licenses/MIT",
  author: {
    "@type": "Organization",
    name: "dotfn",
    url: "https://dotfn.dev",
  },
  codeRepository: "https://github.com/dotfn/brewmenu",
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl("en", "")} />
    <link rel="alternate" hreflang="es" href={getAbsoluteLocaleUrl("es", "")} />
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl("en", "")} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="BrewMenu" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@dotfn_" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
    <Font cssVariable="--font-inter" preload />
    <script is:inline>
      const storedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (storedTheme === "dark" || (!storedTheme && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("js");
      }
    </script>
  </head>
  <body class="bg-canvas font-text text-ink antialiased selection:bg-primary/30 dark:bg-void dark:text-white">
    <slot />
  </body>
</html>
